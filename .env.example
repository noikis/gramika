OPENROUTER_API_KEY=your_openrouter_api_key
# Local development only; the Docker image sets production independently.
NODE_ENV=development
# Docker Compose host port, used for both the built web interface and API.
GRAMOTA_PORT=3000
# Optional database path, relative to apps/server unless absolute.
# SQLITE_PATH=data/gramota.sqlite
# Mandatory in Docker/production; ignored during local development.
OPENROUTER_PROXY_URL=
