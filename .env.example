OPENROUTER_API_KEY=your_openrouter_api_key
# Local development only; the Docker image sets production independently.
NODE_ENV=development
# Docker Compose host port, used for both the built web interface and API.
GRAMOTA_PORT=3000
# Optional database path, relative to apps/server unless absolute.
# SQLITE_PATH=data/gramota.sqlite
# Mandatory in Docker/production; ignored during local development.
OPENROUTER_PROXY_URL=
LIBRETRANSLATE_URL=https://libretranslate.com
# Optional server-only dictionary service, accessed directly without the OpenRouter proxy.
DICTIONARY_BASE_URL=https://wiktapi.dev
# Authentication (required for production auth flows)
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_ORIGIN=http://localhost:5173
API_PROXY_TARGET=http://127.0.0.1:3000
